# Copy this file to .env. Leave unused values unset.

# agent (default) or user
MCP_AUTH_MODE=agent

# Public origin, no path. Required in production user mode.
# MCP_PUBLIC_ORIGIN=http://localhost:3000

# Required when MCP_AUTH_MODE=user. Same string as workast-auth AUTH_URL.
# WORKAST_AUTH_URL=http://localhost:8027

# Workast API origin. Defaults to https://api.workast.com.
# WORKAST_API_URL=http://localhost:8080

# Bearer token for local evals and agent-mode clients.
WORKAST_API_KEY=

# Vercel AI Gateway key. Required for npm run eval.
AI_GATEWAY_API_KEY=

# Customer.io CDP. Unset means analytics is a no-op.
# CUSTOMERIO_WRITE_KEY=
# CUSTOMERIO_HOST=https://cdp-eu.customer.io

LOG_LEVEL=info
